snippet svc
const PACKAGE = "$2"
const TAG = \`${PACKAGE}/$1\`
export class $1 extends Effect.Service<$1>()(TAG, {
	dependencies: [],
	effect: Effect.gen(function* () {
		const todo = yield* Effect.succeed(true)
