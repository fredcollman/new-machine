const PACKAGE = "$2"
const TAG = \`${PACKAGE}/$1\`

const annotated = Effect.annotateLogs({
	service: TAG
})

const make = Effect.gen(function*() {
	const todo = Effect.fn(\`${TAG}.todo\`)(function* () {
		yield* Effect.log("TODO")
	}, annotated)

	return {
		todo,
	} as const
}).pipe(annotated)

export type $1Shape = Effect.Effect.Success<typeof make>

export class $1 extends Context.Tag(TAG)<
	$1,
	$1Shape
>() {}

export const use: <A, E, R>(f: (service: $1Shape) => Effect.Effect<A, E, R>) => Effect.Effect<A, E, $1 | R> = (f) => $1.pipe(Effect.flatMap(service => f(service)))

export const layerSimple = Layer.effect($1, make);

export const layer = layerSimple.pipe(
	Layer.provide(Layer.empty),
);
endsnippet

snippet isvc
