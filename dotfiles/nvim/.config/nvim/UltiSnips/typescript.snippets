	service: TAG
})

export interface $1Shape {
	changeme: () => Effect.Effect<void>;
}

export class $1 extends Context.Tag(TAG)<
	$1,
	$1Shape
>() {}

const make = Effect.gen(function*() {
	yield* Effect.log("TODO make");

	const changeme = Effect.fn(\`${TAG}.changeme\`)(function*() {
		yield* Effect.log("TODO changeme");
	}, annotated);

	return $1.of({
